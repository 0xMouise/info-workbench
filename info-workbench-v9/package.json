{
  "name": "info-workbench-local",
  "version": "9.0.0",
  "private": true,
  "description": "Local SQLite-backed information collection workspace with Agent MCP integration",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp.js",
    "test": "node --test dist/tests/*.test.js",
    "test:browser": "node scripts/browser-regression.mjs",
    "test:canvas-performance": "node scripts/canvas-performance.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.9.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "highlight.js": "^11.9.0",
    "marked": "^11.1.1",
    "typescript": "5.9.3"
  }
}
